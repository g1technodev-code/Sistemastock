# URL base de la API del backend
VITE_API_URL=http://localhost:4000/api

# Bypass temporal de login (sin backend desplegado).
# En true, la app entra directo con un usuario ADMIN simulado y no llama a /auth/*.
# Las demas llamadas a la API van a fallar hasta que el backend este online: es esperado.
# Poner en false (o quitar la variable) cuando el backend ya este deployado.
VITE_SKIP_AUTH=false
