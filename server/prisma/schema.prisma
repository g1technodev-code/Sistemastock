generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum LocalStatus {
  ACTIVE
  DUE_SOON
  SUSPENDED
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  monthlyPrice  Decimal  @default(0) @db.Decimal(12, 2)
  maxAdmins     Int      @default(1)
  maxEmployees  Int      @default(3)
  isTrial       Boolean  @default(false)
  trialDays     Int?
  isRecommended Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  features      String[] @default([])
  enabledFeatures String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  locales Local[]

  @@map("plans")
}

model Local {
  id           String      @id @default(cuid())
  name         String
  ownerEmail   String
  planId       String
  plan         Plan        @relation(fields: [planId], references: [id])
  isTrial      Boolean     @default(false)
  status       LocalStatus @default(ACTIVE)
  dueDate      DateTime
  monthlyPrice Decimal     @default(24900) @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt


  users            User[]
  categories       Category[]
  suppliers        Supplier[]
  products         Product[]
  sales            Sale[]
  purchases        Purchase[]
  inventoryCounts  InventoryCount[]
  cashRegisters    CashRegister[]
  cashMovements    CashMovement[]
  cashShifts       CashShift[]
  businessSettings BusinessSettings?
  customers        Customer[]
  notifications    Notification[]
  stockMovements   StockMovement[]

  @@index([planId])
  @@map("locales")
}


enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CUENTA_CORRIENTE
}

enum CustomerMovementType {
  CHARGE
  PAYMENT
}

enum NotificationType {
  LOW_STOCK
  SHIFT_OPEN
  SHIFT_CLOSE
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum CashMovementType {
  SALE_IN
  WITHDRAWAL
  ADJUSTMENT
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum InventoryCountStatus {
  OPEN
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  localId      String?
  local        Local?   @relation(fields: [localId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements                StockMovement[]
  refreshTokens            RefreshToken[]
  sales                    Sale[]             @relation("SaleCreatedBy")
  voidedSales              Sale[]             @relation("SaleVoidedBy")
  cashMovements            CashMovement[]     @relation("CashMovementBy")
  shiftsOpened             CashShift[]        @relation("ShiftOpenedBy")
  shiftsClosed             CashShift[]        @relation("ShiftClosedBy")
  purchasesCreated         Purchase[]         @relation("PurchaseCreatedBy")
  purchasesReceived        Purchase[]         @relation("PurchaseReceivedBy")
  purchasesCancelled       Purchase[]         @relation("PurchaseCancelledBy")
  inventoryCountsStarted   InventoryCount[]   @relation("InventoryCountStartedBy")
  inventoryCountsCompleted InventoryCount[]   @relation("InventoryCountCompletedBy")
  customerMovements        CustomerMovement[] @relation("CustomerMovementUser")

  @@index([localId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(cuid())
  localId     String
  local       Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([localId, name])
  @@index([localId])
  @@map("categories")
}

model Supplier {
  id          String   @id @default(cuid())
  localId     String
  local       Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxId       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  purchases Purchase[]

  @@index([localId])
  @@map("suppliers")
}

model Product {
  id           String   @id @default(cuid())
  localId      String
  local        Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  sku          String
  barcode      String?
  name         String
  description  String?
  unit         String   @default("unidad")
  costPrice    Decimal  @default(0) @db.Decimal(12, 2)
  sellPrice    Decimal  @default(0) @db.Decimal(12, 2)
  currentStock Int      @default(0)
  minStock     Int      @default(0)
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements           StockMovement[]
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  inventoryCountItems InventoryCountItem[]

  @@unique([localId, sku])
  @@index([localId])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}


model StockMovement {
  id             String       @id @default(cuid())
  localId        String
  local          Local        @relation(fields: [localId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  type           MovementType
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  unitCost       Decimal?     @db.Decimal(12, 2)
  reason         String?
  reference      String?
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([localId])
  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

model Sale {
  id            String        @id @default(cuid())
  localId       String
  local         Local         @relation(fields: [localId], references: [id], onDelete: Cascade)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  receiptNumber String?
  payerName     String?
  userId        String
  user          User          @relation("SaleCreatedBy", fields: [userId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  voidedById    String?
  voidedBy      User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidedAt      DateTime?
  createdAt     DateTime      @default(now())

  items             SaleItem[]
  cashMovements     CashMovement[]
  customerMovements CustomerMovement[]

  @@index([localId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Purchase {
  id            String         @id @default(cuid())
  localId       String
  local         Local          @relation(fields: [localId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  status        PurchaseStatus @default(PENDING)
  total         Decimal        @db.Decimal(12, 2)
  note          String?
  userId        String
  user          User           @relation("PurchaseCreatedBy", fields: [userId], references: [id])
  receivedById  String?
  receivedBy    User?          @relation("PurchaseReceivedBy", fields: [receivedById], references: [id])
  receivedAt    DateTime?
  cancelledById String?
  cancelledBy   User?          @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items PurchaseItem[]

  @@index([localId])
  @@index([supplierId])
  @@index([createdAt])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model InventoryCount {
  id            String                @id @default(cuid())
  localId       String
  local         Local                 @relation(fields: [localId], references: [id], onDelete: Cascade)
  status        InventoryCountStatus  @default(OPEN)
  note          String?
  startedById   String
  startedBy     User                  @relation("InventoryCountStartedBy", fields: [startedById], references: [id])
  startedAt     DateTime              @default(now())
  completedById String?
  completedBy   User?                 @relation("InventoryCountCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?

  items InventoryCountItem[]

  @@index([localId])
  @@index([startedById])
  @@index([status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  systemQuantity   Int
  countedQuantity  Int
  difference       Int
  countedAt        DateTime       @default(now())

  @@unique([inventoryCountId, productId])
  @@index([inventoryCountId])
  @@index([productId])
  @@map("inventory_count_items")
}

model CashRegister {
  id             String   @id @default(cuid())
  localId        String   @unique
  local          Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  @@index([localId])
  @@map("cash_register")
}

model CashMovement {
  id            String           @id @default(cuid())
  localId       String
  local         Local            @relation(fields: [localId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  balanceBefore Decimal          @db.Decimal(12, 2)
  balanceAfter  Decimal          @db.Decimal(12, 2)
  saleId        String?
  sale          Sale?            @relation(fields: [saleId], references: [id])
  userId        String
  user          User             @relation("CashMovementBy", fields: [userId], references: [id])
  note          String?
  createdAt     DateTime         @default(now())

  @@index([localId])
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("cash_movements")
}

model CashShift {
  id                 String          @id @default(cuid())
  localId            String
  local              Local           @relation(fields: [localId], references: [id], onDelete: Cascade)
  openedById         String
  openedBy           User            @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  openedAt           DateTime        @default(now())
  openingCounted     Decimal         @db.Decimal(12, 2)
  openingExpected    Decimal         @db.Decimal(12, 2)
  openingDiscrepancy Decimal         @db.Decimal(12, 2)
  closedById         String?
  closedBy           User?           @relation("ShiftClosedBy", fields: [closedById], references: [id])
  closedAt           DateTime?
  closingCounted     Decimal?        @db.Decimal(12, 2)
  closingExpected    Decimal?        @db.Decimal(12, 2)
  closingDiscrepancy Decimal?        @db.Decimal(12, 2)
  status             CashShiftStatus @default(OPEN)
  note               String?

  @@index([localId])
  @@index([openedAt])
  @@index([openedById, status])
  @@map("cash_shifts")
}

model BusinessSettings {
  id           String   @id @default(cuid())
  localId      String   @unique
  local        Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  businessName String   @default("Mi Negocio")
  taxId        String?
  address      String?
  phone        String?
  email        String?
  logoUrl      String?
  updatedAt    DateTime @updatedAt

  @@map("business_settings")
}

model Customer {
  id             String   @id @default(cuid())
  localId        String
  local          Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  name           String
  taxId          String?
  email          String?
  phone          String?
  address        String?
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal? @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales     Sale[]
  movements CustomerMovement[]

  @@index([localId])
  @@map("customers")
}

model CustomerMovement {
  id            String               @id @default(cuid())
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          CustomerMovementType
  amount        Decimal              @db.Decimal(12, 2)
  balanceBefore Decimal              @db.Decimal(12, 2)
  balanceAfter  Decimal              @db.Decimal(12, 2)
  saleId        String?
  sale          Sale?                @relation(fields: [saleId], references: [id])
  userId        String
  user          User                 @relation("CustomerMovementUser", fields: [userId], references: [id])
  note          String?
  createdAt     DateTime             @default(now())

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("customer_movements")
}

model Notification {
  id        String           @id @default(cuid())
  localId   String
  local     Local            @relation(fields: [localId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([localId])
  @@index([createdAt])
  @@index([isRead])
  @@map("notifications")
}

