generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum CashMovementType {
  SALE_IN
  WITHDRAWAL
  ADJUSTMENT
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements     StockMovement[]
  refreshTokens RefreshToken[]
  sales         Sale[]          @relation("SaleCreatedBy")
  voidedSales   Sale[]          @relation("SaleVoidedBy")
  cashMovements CashMovement[]  @relation("CashMovementBy")
  shiftsOpened  CashShift[]     @relation("ShiftOpenedBy")
  shiftsClosed  CashShift[]     @relation("ShiftClosedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxId       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("suppliers")
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  barcode      String?
  name         String
  description  String?
  unit         String   @default("unidad")
  costPrice    Decimal  @default(0) @db.Decimal(12, 2)
  sellPrice    Decimal  @default(0) @db.Decimal(12, 2)
  currentStock Int      @default(0)
  minStock     Int      @default(0)
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements StockMovement[]
  saleItems SaleItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

model StockMovement {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  type           MovementType
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  unitCost       Decimal?     @db.Decimal(12, 2)
  reason         String?
  reference      String?
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

model Sale {
  id            String        @id @default(cuid())
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  receiptNumber String?
  payerName     String?
  userId        String
  user          User          @relation("SaleCreatedBy", fields: [userId], references: [id])
  voidedById    String?
  voidedBy      User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidedAt      DateTime?
  createdAt     DateTime      @default(now())

  items         SaleItem[]
  cashMovements CashMovement[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model CashRegister {
  id             String   @id @default(cuid())
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  @@map("cash_register")
}

model CashMovement {
  id            String           @id @default(cuid())
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  balanceBefore Decimal          @db.Decimal(12, 2)
  balanceAfter  Decimal          @db.Decimal(12, 2)
  saleId        String?
  sale          Sale?            @relation(fields: [saleId], references: [id])
  userId        String
  user          User             @relation("CashMovementBy", fields: [userId], references: [id])
  note          String?
  createdAt     DateTime         @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@map("cash_movements")
}

model CashShift {
  id                 String          @id @default(cuid())
  openedById         String
  openedBy           User            @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  openedAt           DateTime        @default(now())
  openingCounted     Decimal         @db.Decimal(12, 2)
  openingExpected    Decimal         @db.Decimal(12, 2)
  openingDiscrepancy Decimal         @db.Decimal(12, 2)
  closedById         String?
  closedBy           User?           @relation("ShiftClosedBy", fields: [closedById], references: [id])
  closedAt           DateTime?
  closingCounted     Decimal?        @db.Decimal(12, 2)
  closingExpected    Decimal?        @db.Decimal(12, 2)
  closingDiscrepancy Decimal?        @db.Decimal(12, 2)
  status             CashShiftStatus @default(OPEN)
  note               String?

  @@index([openedAt])
  @@index([openedById, status])
  @@map("cash_shifts")
}

model BusinessSettings {
  id           String   @id @default(cuid())
  businessName String   @default("Mi Negocio")
  taxId        String?
  address      String?
  phone        String?
  email        String?
  currency     String   @default("USD")
  logoUrl      String?
  updatedAt    DateTime @updatedAt

  @@map("business_settings")
}
